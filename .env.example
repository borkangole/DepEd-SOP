# Supabase project settings — get these from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key used ONLY in trusted server code (never expose to the browser).
# Used for admin-level operations like creating users with a fixed role from an invite flow.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
